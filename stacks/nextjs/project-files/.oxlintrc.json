{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "import",
    "nextjs",
    "unicorn"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-deprecated": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "eslint/func-style": [
      "error",
      "expression"
    ],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": [
        "lib/**",
        "components/**",
        "db/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/**",
                  "@/app/**"
                ],
                "message": "Shared code (lib/, components/, db/) never imports a feature or a route; move the shared piece down instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
